# SmartRoute AI — Clean Bharat Intelligence Platform
# Environment Configuration Template (.env.example)

PROJECT_NAME="SmartRoute AI — Clean Bharat Intelligence Platform"
API_V1_STR="/api"

# Security & Session
SECRET_KEY="clean-bharat-hackathon-2026-super-secret-key-change-in-prod"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default is local SQLite. For PostgreSQL, set: postgresql://user:password@localhost:5432/cleanbharat
DATABASE_URL="sqlite:///./cleanbharat.db"

# Storage
UPLOAD_DIR="backend/uploads"

# OSRM Road Matrix Service (Leave as default public demo or point to local OSRM instance)
# If unreachable or timeout occurs, system falls back to calibrated Haversine matrix.
OSRM_BASE_URL="http://router.project-osrm.org"
OSRM_TIMEOUT_SECONDS=3.0

# Hardware IoT Extension Header
# Secret header checked by POST /api/iot/readings (X-API-Key)
IOT_API_KEY="esp32-sensor-cleanbharat-key"

# External Integrations (Honesty Rule: Leave blank unless you have real production credentials)
# If left blank, rainfall risk is honestly displayed as "not configured / estimate"
WEATHER_API_KEY=""

# If left blank, natural language assistant operates via deterministic local SQL intent engine
LLM_API_KEY=""

# Frontend API URL (for Vite)
VITE_API_BASE_URL="http://localhost:8000/api"
